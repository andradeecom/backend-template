# App config
NODE_ENV=development
PORT=3001
MAX_VIDEO_FILE_SIZE=1073741824
FRONTEND_URL="http://localhost:3000"

# Database
DATABASE_URL=""
POSTGRES_DB=""
POSTGRES_PASSWORD=""
POSTGRES_USER=""

# Sessions
# Auth uses opaque, server-backed session ids stored in httpOnly cookies.
# There are no signing secrets to rotate: revoking a session is a DELETE.
# Lifetimes live in src/auth/session/session.constants.ts.

# Comma-separated extra origins allowed to send credentialed requests.
# FRONTEND_URL is always included.
ALLOWED_ORIGINS=""

# Set to "true" ONLY when the app runs behind a proxy/load balancer you control
# (nginx, ALB, Cloudflare, Fly, Railway...). It makes rate limiting read the
# client IP from X-Forwarded-For for anonymous requests.
#
# Leave false when the app is directly exposed: a client could otherwise forge
# that header to get a fresh bucket and bypass the login/password-reset limits.
#
# Leaving it false behind a proxy is the opposite failure: every anonymous
# request appears to come from the proxy's IP, so all users share one bucket and
# those limits become far stricter than intended.
TRUST_PROXY="false"


# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME=""
CLOUDFLARE_R2_PUBLIC_URL=""

# Resend template key
RESEND_API_KEY=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# 