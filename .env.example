# App config
NODE_ENV=development
PORT=3001
MAX_VIDEO_FILE_SIZE=1073741824
FRONTEND_URL="http://localhost:3000"

# Database
DATABASE_URL=""
POSTGRES_DB=""
POSTGRES_PASSWORD=""
POSTGRES_USER=""

# Sessions
# Auth uses opaque, server-backed session ids stored in httpOnly cookies.
# There are no signing secrets to rotate: revoking a session is a DELETE.
# Lifetimes live in src/auth/session/session.constants.ts.

# Comma-separated extra origins allowed to send credentialed requests.
# FRONTEND_URL is always included.
ALLOWED_ORIGINS=""

# Which upstream proxies may be believed about the client's IP, which is what
# anonymous rate limiting keys on. Leave EMPTY when this app is exposed directly
# or when rate limiting lives at the edge (the safe default) — X-Forwarded-For
# is then ignored entirely.
#
# Accepts a CIDR/IP allow-list (preferred) or a hop count. "true" is NOT
# supported: it makes Express believe the client-supplied entry.
#
# Setup, and the firewall rules this depends on: docs/deployment.md
TRUSTED_PROXIES=""


# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME=""
CLOUDFLARE_R2_PUBLIC_URL=""

# Resend template key
RESEND_API_KEY=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# 