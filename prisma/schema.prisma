generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

model User {
  id                 String       @id @default(uuid())
  email              String       @unique
  password           String
  firstName          String
  lastName           String
  role               UserRole     @default(STUDENT)
  authProvider       AuthProvider @default(LOCAL)
  googleId           String?      @unique
  profileImageUrl    String?
  isActive           Boolean      @default(true)
  mustChangePassword Boolean      @default(true)
  emailVerifiedAt    DateTime?
  createdById        String?
  lastLoginAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  sessions           Session[]
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]

  @@map("users")
}

model Session {
  id                String   @id @default(uuid())
  /// SHA-256 of the opaque session id handed to the client. The raw value is
  /// never stored, so a database leak does not yield usable sessions.
  tokenHash         String   @unique
  userId            String
  /// Sessions rotated from one another share a family. Presenting a rotated-away
  /// id burns the whole family — that is the reuse detection.
  familyId          String
  expiresAt         DateTime
  /// Absolute cap: rotation extends `expiresAt` but never past this.
  absoluteExpiresAt DateTime
  revoked           Boolean  @default(false)
  userAgent         String?
  ipAddress         String?
  lastUsedAt        DateTime @default(now())
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthCode {
  id        String   @id @default(uuid())
  code      String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("auth_codes")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}
